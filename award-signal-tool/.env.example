# Trepoトレンド大賞 実績シグナル収集ツール 環境変数
# このファイルを .env にコピーして値を埋める（.env はコミットしない）

# Notion
NOTION_TOKEN=ntn_xxxxxxxx
CANDIDATE_DB_ID=3832a9c9-20f7-81ad-a21e-fee38dfd4b8c
SEED_DB_ID=3832a9c9-20f7-811b-b44f-d11874a495c7

# 実績シグナル取得スクリプト用（取得を実行するなら必要）
APIFY_TOKEN=
YOUTUBE_API_KEY=

# Googleログイン（本番のみ。ローカルは未設定でログイン不要）
# GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
# ALLOWED_HD=creativegroup.co.jp        # 社内Workspaceドメインで制限（推奨）
# ALLOWED_EMAILS=a@example.com,b@example.com  # 個別Gmail許可（任意）

# サーバー
PORT=4000
